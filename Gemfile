# Mismo Jekyll y plugins que usa GitHub Pages, para que la vista previa local coincida.
source "https://rubygems.org"
gem "github-pages", group: :jekyll_plugins
gem "webrick"   # Ruby 3.x ya no lo trae; `jekyll serve` lo necesita
gem "erb"      # Ruby 3.4 la sacó de la librería estándar; Jekyll 3.10 la asume
